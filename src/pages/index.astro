---
import BaseLayout from "../layouts/BaseLayout.astro";
import SignalField from "../components/SignalField.astro";
import { proximidad, enapresExtorsion, fmt } from "../lib/data";

const cifraNegra = enapresExtorsion.dominios.find((d: any) => d.dominio === "Lima + Callao (ciudad)");
const afectados = proximidad.afectados_100m;
const alumnosDocentes = afectados.alumnos_expuestos + afectados.docentes_expuestos;
---
<BaseLayout
  title="Portada"
  description="GeoEscudo: mapear la amenaza para devolver la tranquilidad a las generaciones del futuro. Inteligencia territorial contra la extorsión en entornos escolares de Lima y Callao."
>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <SignalField />
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Inteligencia territorial · Lima y Callao</span>
        <h1>GeoEscudo: mapear la amenaza para devolver la tranquilidad a las generaciones del futuro.</h1>
        <p class="lede">
          GeoEscudo es un observatorio territorial georreferenciado de denuncias policiales de extorsión
          y de II.EE. Abordamos la desconfianza que nunca llega a denunciarse para señalar dónde intervenir primero en el entorno escolar.
        </p>

        <div class="cta-row">
          <a class="btn primary" href="/explorador/">Vamos al explorador →</a>
          <a class="btn secondary" href="/estrategia/">Nuestra estrategia de intervención</a>
        </div>

        <div class="freshness-chip" style="margin-top:28px;">
          <span class="dot"></span>Fuentes: SIDPOL · ENAPRES 2025 · Padron Web MINEDU
        </div>
      </div>
      <div class="hero-seal reveal">
        <img src="/logos/geoescudo_logo_oficial.png" alt="GeoEscudo" width="220" height="120" />
      </div>
    </div>
  </section>

  <section class="section kpi-open">
    <div class="wrap">
      <div class="kpi-grid" data-reveal-group>
        <div class="panel-card kpi-block reveal">
          <div class="kpi-num count-up" data-target={cifraNegra.cifra_negra_pct} data-decimals="1" data-suffix="%">0.0%</div>
          <div class="kpi-label">No denuncia su victimización por extorsión</div>
          <p class="kpi-limit">Lima + Callao, Registros de Vtimización en ENAPRES 2025 </p>
        </div>
        <div class="panel-card kpi-block reveal">
          <div class="kpi-num count-up" data-target={afectados.n_locales} data-decimals="0">0</div>
          <div class="kpi-label">Locales educativos con denuncia ≤100 m</div>
          <p class="kpi-limit">{afectados.pct_locales}% del total de locales activos en Lima y Callao (fuente: MINEDU + SIDPOL).</p>
        </div>
        <div class="panel-card kpi-block reveal">
          <div class="kpi-num count-up" data-target={alumnosDocentes} data-decimals="0">0</div>
          <div class="kpi-label">Alumnos y docentes expuestos</div>
          <p class="kpi-limit">Población censada (Censo Educativo) en los locales afectados por extorsión en su entorno inmediato.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">El recorrido</span>
        <h2>Del diagnóstico territorial a la acción.</h2>
      </div>
      <div class="mission-list" data-reveal-group>
        <div class="mission-row reveal">
          <span class="m-idx">0.1</span>
          <div class="m-body">
            <h3>El mapa delimita las zonas</h3>
            <p>Aquí el mapa visualiza los datos: denuncias, victimización y la distribución territorial de las instituciones educativas. <a href="/explorador/">Explorar el mapa →</a></p>
          </div>
        </div>
        <div class="mission-row reveal">
          <span class="m-idx">0.2</span>
          <div class="m-body">
            <h3>Identificamos las IIEE priorizadas</h3>
            <p>Aquí el mapa visualiza las instituciones educativas más afectadas y, por otro lado, la brecha entre denuncia y victimización, el registro real de extorsión. <a href="/iiee-priorizadas/">Ver la priorización →</a></p>
          </div>
        </div>
        <div class="mission-row reveal">
          <span class="m-idx">0.3</span>
          <div class="m-body">
            <h3>Desplegamos la estrategia</h3>
            <p>Un ciclo de 4 sesiones de encuentro comunidad-escuela-policía, basado en la literatura de evidencia de <em>community policing</em>. <a href="/estrategia/">Ver la estrategia →</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; padding: 88px 0 56px; overflow: hidden; min-height: min(80vh, 640px); display: flex; align-items: center; }
  .hero-bg {
    position: absolute; inset: 0; z-index: 0;
    background:
      radial-gradient(ellipse 900px 500px at 15% -10%, rgba(61,90,128,.10), transparent 60%),
      radial-gradient(ellipse 700px 420px at 100% 20%, rgba(238,108,77,.08), transparent 60%),
      var(--bg);
  }
  .hero :global(.signal-field) { z-index: 0; opacity: .9; }
  .hero-inner {
    position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between;
    gap: 40px; flex-wrap: wrap;
  }
  .hero-copy { flex: 1 1 480px; min-width: 0; }
  .hero h1 { margin: 18px 0 20px; max-width: 20ch; }
  .hero-seal {
    flex: none; background: #fff; border: 1px solid var(--line); border-radius: 20px;
    padding: 18px 26px; box-shadow: 0 12px 32px rgba(41,50,65,.1);
  }
  .hero-seal img { display: block; width: 220px; height: auto; }
  .kpi-open { padding-top: 8px; }

  @media (max-width: 860px) {
    .hero-inner { flex-direction: column-reverse; }
    .hero-seal img { width: 160px; }
  }
</style>
