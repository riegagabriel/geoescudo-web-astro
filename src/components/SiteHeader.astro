---
const nav = [
  { href: "/explorador/", label: "Explorador" },
  { href: "/iiee-priorizadas/", label: "Instituciones priorizadas" },
  { href: "/estrategia/", label: "Estrategia" },
  { href: "/metodologia/", label: "Metodología" },
  { href: "/acerca-de/", label: "Acerca de" },
];
const currentPath = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label="GeoEscudo — inicio">
      <span class="brand-badge">
        <img src="/logos/geoescudo_logo_oficial_shield.png" alt="" width="40" height="40" />
      </span>
      <span class="brand-text">
        <b>GeoEscudo</b>
        <em>Observatorio de Brecha de Denuncia</em>
      </span>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" id="nav-toggle" aria-label="Abrir navegación">
      <span class="bar bar-1"></span><span class="bar bar-2"></span><span class="bar bar-3"></span>
    </button>
    <nav id="site-nav" class="site-nav">
      <span class="nav-indicator" aria-hidden="true"></span>
      {nav.map((item, i) => (
        <a href={item.href} data-nav-link style={`--i:${i}`} aria-current={currentPath.startsWith(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 40; background: rgba(224,251,252,.86); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; padding: 12px 24px; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .brand-badge {
    display: flex; align-items: center; justify-content: center; flex: none;
    width: 44px; height: 44px; border-radius: 12px; background: #fff;
    border: 1px solid var(--line); box-shadow: 0 1px 3px rgba(41,50,65,.08);
    overflow: hidden;
  }
  .brand-badge img { width: 40px; height: 40px; object-fit: contain; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-text b { font: 800 1.05rem/1 var(--font-sans); color: var(--ink); }
  .brand-text em { font: 600 .64rem/1 var(--font-mono); color: var(--amber-dim); letter-spacing: .06em; text-transform: uppercase; font-style: normal; margin-top: 4px; }

  .site-nav { position: relative; display: flex; gap: 6px; }
  .site-nav a {
    position: relative; z-index: 1;
    font: 600 .82rem/1 var(--font-sans); color: var(--ink-2); text-decoration: none;
    padding: 9px 13px; border-radius: 7px; white-space: nowrap;
    transition: color 180ms var(--ease-out-strong);
  }
  .site-nav a[aria-current="page"] { color: var(--ink); box-shadow: inset 0 -2px 0 var(--amber); }
  .site-nav a:hover { color: var(--ink); }

  /* Pastilla que se desliza detrás del link activo/hover — medida en JS */
  .nav-indicator {
    position: absolute; top: 0; left: 0; height: 100%; border-radius: 7px;
    background: var(--surface);
    transform: translateX(var(--nav-x, 0)) scaleX(var(--nav-w, 0));
    transform-origin: left center;
    width: 1px; opacity: 0;
    transition: transform 320ms var(--ease-out-strong), opacity 200ms var(--ease-out-strong);
  }
  .site-nav.indicator-ready .nav-indicator { opacity: 1; }

  .nav-toggle {
    display: none; flex-direction: column; justify-content: center; align-items: center; gap: 5px;
    background: none; border: none; cursor: pointer; padding: 10px; width: 40px; height: 40px;
  }
  .nav-toggle .bar { width: 20px; height: 2px; background: var(--ink-2); border-radius: 2px; transition: transform 220ms var(--ease-out-strong), opacity 220ms var(--ease-out-strong); }
  .nav-toggle[aria-expanded="true"] .bar-1 { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] .bar-2 { opacity: 0; }
  .nav-toggle[aria-expanded="true"] .bar-3 { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 860px) {
    .site-nav {
      position: absolute; top: 100%; left: 0; right: 0; background: var(--panel);
      border-bottom: 1px solid var(--line); flex-direction: column; padding: 8px;
      transform: translateY(-8px); opacity: 0; visibility: hidden; pointer-events: none;
      box-shadow: 0 12px 24px rgba(41,50,65,.08);
      transition: transform 240ms var(--ease-out-strong), opacity 200ms var(--ease-out-strong), visibility 0s linear 240ms;
    }
    .site-nav.open { transform: translateY(0); opacity: 1; visibility: visible; pointer-events: auto; transition: transform 240ms var(--ease-out-strong), opacity 200ms var(--ease-out-strong); }
    .nav-indicator { display: none; }
    .site-nav a {
      opacity: 0; transform: translateY(6px);
      transition: opacity 260ms var(--ease-out-strong), transform 260ms var(--ease-out-strong), color 180ms var(--ease-out-strong);
      transition-delay: calc(var(--i) * 40ms);
    }
    .site-nav.open a { opacity: 1; transform: none; }
    .nav-toggle { display: flex; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-indicator, .nav-toggle .bar, .site-nav, .site-nav a { transition: none !important; }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle") as HTMLButtonElement | null;
  const nav = document.querySelector<HTMLElement>(".site-nav");
  toggle?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
  });

  // Pastilla deslizante: sigue el link activo por defecto, y el hover/focus
  // en escritorio — apple-design: anima desde el valor actual, nunca de golpe.
  if (nav && window.matchMedia("(min-width: 861px)").matches) {
    const indicator = nav.querySelector<HTMLElement>(".nav-indicator");
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"));
    const current = nav.querySelector<HTMLAnchorElement>('[aria-current="page"]');

    function moveTo(el: HTMLElement) {
      const navRect = nav!.getBoundingClientRect();
      const rect = el.getBoundingClientRect();
      nav!.style.setProperty("--nav-x", `${rect.left - navRect.left}px`);
      nav!.style.setProperty("--nav-w", "1");
      indicator!.style.width = `${rect.width}px`;
    }

    if (current) {
      requestAnimationFrame(() => {
        moveTo(current);
        nav!.classList.add("indicator-ready");
      });
    }
    links.forEach((link) => {
      link.addEventListener("mouseenter", () => moveTo(link));
      link.addEventListener("focus", () => moveTo(link));
    });
    nav.addEventListener("mouseleave", () => { if (current) moveTo(current); });
  }
</script>
